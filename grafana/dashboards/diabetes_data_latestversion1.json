        {
          "dataset": "airflow_db",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Risk-Confidence Matrix Query\r\nWITH risk_matrix AS (\r\n  SELECT\r\n    CASE \r\n      WHEN prediction = 1 AND glucose > 180 THEN 'Critical'\r\n      WHEN prediction = 1 AND glucose > 140 THEN 'High'\r\n      WHEN prediction = 1 THEN 'Medium'\r\n      ELSE 'Low'\r\n    END AS risk_level,\r\n    CASE \r\n      WHEN bmi >= 30 THEN 'High BMI'\r\n      WHEN bmi >= 25 THEN 'Medium BMI'\r\n      ELSE 'Normal BMI'\r\n    END AS bmi_category\r\n  FROM diabetes_data\r\n)\r\nSELECT\r\n  risk_level AS \"Risk Level\",\r\n  COUNT(*) FILTER (WHERE bmi_category = 'High BMI') AS \"High BMI\",\r\n  COUNT(*) FILTER (WHERE bmi_category = 'Medium BMI') AS \"Medium BMI\",\r\n  COUNT(*) FILTER (WHERE bmi_category = 'Normal BMI') AS \"Normal BMI\"\r\nFROM risk_matrix\r\nGROUP BY risk_level\r\nORDER BY \r\n  CASE risk_level \r\n    WHEN 'Critical' THEN 1\r\n    WHEN 'High' THEN 2\r\n    WHEN 'Medium' THEN 3\r\n    ELSE 4\r\n  END;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Risk Matrix ",
      "type": "barchart"
    },
