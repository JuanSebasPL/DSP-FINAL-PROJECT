          "rawSql": "SELECT \r\n    CASE \r\n        WHEN bmi < 18.5 THEN 'Underweight'\r\n        WHEN bmi >= 18.5 AND bmi < 25 THEN 'Normal'\r\n        WHEN bmi >= 25 AND bmi < 30 THEN 'Overweight'\r\n        ELSE 'Obese'\r\n    END as bmi_category,\r\n    COUNT(*) as count\r\nFROM diabetes_data\r\nGROUP BY \r\n    CASE \r\n        WHEN bmi < 18.5 THEN 'Underweight'\r\n        WHEN bmi >= 18.5 AND bmi < 25 THEN 'Normal'\r\n        WHEN bmi >= 25 AND bmi < 30 THEN 'Overweight'\r\n        ELSE 'Obese'\r\n    END\r\nORDER BY \r\n    CASE \r\n        CASE \r\n            WHEN bmi < 18.5 THEN 'Underweight'\r\n            WHEN bmi >= 18.5 AND bmi < 25 THEN 'Normal'\r\n            WHEN bmi >= 25 AND bmi < 30 THEN 'Overweight'\r\n            ELSE 'Obese'\r\n        END\r\n        WHEN 'Underweight' THEN 1\r\n        WHEN 'Normal' THEN 2\r\n        WHEN 'Overweight' THEN 3\r\n        WHEN 'Obese' THEN 4\r\n    END;",
