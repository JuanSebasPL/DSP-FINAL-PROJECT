          "rawSql": "SELECT \r\n    CASE \r\n        WHEN prediction_confidence >= 0.9 THEN 'Very High (90-100%)'\r\n        WHEN prediction_confidence >= 0.7 THEN 'High (70-90%)'\r\n        WHEN prediction_confidence >= 0.5 THEN 'Medium (50-70%)'\r\n        ELSE 'Low (<50%)'\r\n    END as \"Confidence Level\",\r\n    COUNT(*) as \"Count\"\r\nFROM diabetes_data\r\nWHERE prediction_confidence IS NOT NULL\r\nGROUP BY \r\n    CASE \r\n        WHEN prediction_confidence >= 0.9 THEN 'Very High (90-100%)'\r\n        WHEN prediction_confidence >= 0.7 THEN 'High (70-90%)'\r\n        WHEN prediction_confidence >= 0.5 THEN 'Medium (50-70%)'\r\n        ELSE 'Low (<50%)'\r\n    END\r\nORDER BY MIN(prediction_confidence) DESC;",
