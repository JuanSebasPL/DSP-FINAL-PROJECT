          "rawQuery": true,
          "rawSql": "WITH metrics AS (\r\n    SELECT \r\n        SUM(CASE WHEN prediction = 1 AND actual_outcome = 1 THEN 1 ELSE 0 END)::FLOAT as tp,\r\n        SUM(CASE WHEN prediction = 1 AND actual_outcome = 0 THEN 1 ELSE 0 END)::FLOAT as fp,\r\n        SUM(CASE WHEN prediction = 0 AND actual_outcome = 1 THEN 1 ELSE 0 END)::FLOAT as fn\r\n    FROM diabetes_data\r\n    WHERE actual_outcome IS NOT NULL\r\n),\r\ncalc AS (\r\n    SELECT \r\n        tp / NULLIF(tp + fp, 0) as precision,\r\n        tp / NULLIF(tp + fn, 0) as recall\r\n    FROM metrics\r\n)\r\nSELECT \r\n    ROUND(CAST((2 * precision * recall / NULLIF(precision + recall, 0)) * 100 AS NUMERIC), 2) as value\r\nFROM calc;",
