      "targets": [
        {
          "dataset": "airflow_db",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH metrics AS (\r\n    SELECT \r\n        COUNT(*) as total_predictions,\r\n        SUM(CASE WHEN prediction = actual_outcome THEN 1 ELSE 0 END) as correct_predictions,\r\n        SUM(CASE WHEN prediction = 1 AND actual_outcome = 1 THEN 1 ELSE 0 END) as true_positives,\r\n        SUM(CASE WHEN prediction = 1 AND actual_outcome = 0 THEN 1 ELSE 0 END) as false_positives,\r\n        SUM(CASE WHEN prediction = 0 AND actual_outcome = 1 THEN 1 ELSE 0 END) as false_negatives,\r\n        SUM(CASE WHEN prediction = 0 AND actual_outcome = 0 THEN 1 ELSE 0 END) as true_negatives\r\n    FROM diabetes_data\r\n    WHERE actual_outcome IS NOT NULL\r\n)\r\nSELECT \r\n    'Total Predictions' as \"Metric\",\r\n    CAST(total_predictions AS TEXT) as \"Value\"\r\nFROM metrics\r\nUNION ALL\r\nSELECT \r\n    'Accuracy (%)',\r\n    CAST(ROUND(CAST((correct_predictions::FLOAT / NULLIF(total_predictions, 0) * 100) AS NUMERIC), 2) AS TEXT)\r\nFROM metrics\r\nUNION ALL\r\nSELECT \r\n    'Error Rate (%)',\r\n    CAST(ROUND(CAST(((false_positives + false_negatives)::FLOAT / NULLIF(total_predictions, 0) * 100) AS NUMERIC), 2) AS TEXT)\r\nFROM metrics\r\nUNION ALL\r\nSELECT \r\n    'True Positives',\r\n    CAST(true_positives AS TEXT)\r\nFROM metrics\r\nUNION ALL\r\nSELECT \r\n    'False Positives',\r\n    CAST(false_positives AS TEXT)\r\nFROM metrics\r\nUNION ALL\r\nSELECT \r\n    'True Negatives',\r\n    CAST(true_negatives AS TEXT)\r\nFROM metrics\r\nUNION ALL\r\nSELECT \r\n    'False Negatives',\r\n    CAST(false_negatives AS TEXT)\r\nFROM metrics;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Model Performance Summary",
      "type": "table"
    },
